{"name": "OTX Malicious IP Match", "rule_id": "63b32e44-4f21-4ce5-854b-a5d0443a71f5", "type": "threat_match", "severity": "high", "risk_score": 75, "index": ["logs-endpoint.events.network-*", "filebeat-*"], "threat_index": ["logs-ti_otx*"], "description": "Detects source or destination IPs matching OTX indicators."}
{"name": "OTX Malicious Domain Match", "rule_id": "e94d3d53-80f4-4a78-bcc6-2470df663fbb", "type": "threat_match", "severity": "high", "risk_score": 75, "index": ["filebeat-*"], "threat_index": ["logs-ti_otx*"], "description": "Detects malicious domains from OTX."}
{"name": "Apache Web Scan Detection", "rule_id": "988a3b97-87f3-4d25-a795-c08081640531", "type": "threshold", "severity": "medium", "risk_score": 50, "index": ["filebeat-*"], "query": "event.dataset:\"apache.access\" and http.response.status_code:(403 or 404)", "description": "Multiple failed web requests from same IP."}
{"name": "Encoded PowerShell Detection", "rule_id": "68ce294a-c16b-4091-8393-3d268c51473c", "type": "query", "severity": "high", "risk_score": 75, "index": ["logs-endpoint.events.process-*"], "query": "process.name:\"powershell.exe\" and process.command_line:*EncodedCommand*"}
{"name": "Suspicious Office Spawn", "rule_id": "3be33451-5865-4f2a-ba49-81a2ead60afd", "type": "query", "severity": "high", "risk_score": 75, "index": ["logs-endpoint.events.process-*"], "query": "process.parent.name:(winword.exe or excel.exe) and process.name:(cmd.exe or powershell.exe)"}
{"name": "Port Scan Detection", "rule_id": "94dd7291-3abd-44cd-861a-bb063bc6dfd5", "type": "threshold", "severity": "medium", "risk_score": 50, "index": ["logs-endpoint.events.network-*"], "query": "event.category:network"}
{"name": "Windows Failed Logons", "rule_id": "d1f41319-b225-4fbe-9f12-50490932c1dc", "type": "threshold", "severity": "medium", "risk_score": 50, "index": ["logs-*"], "query": "event.code:4625"}
{"name": "Malicious File Hash Match", "rule_id": "895abe98-fa69-45ab-bd0e-47b4b5bcd34d", "type": "threat_match", "severity": "critical", "risk_score": 90, "index": ["logs-endpoint.events.file-*"], "threat_index": ["logs-ti_otx*"]}
{"name": "Ransomware Shadow Copy Deletion", "rule_id": "13087c58-9ab8-4ab7-8f84-aa7182f28476", "type": "query", "severity": "critical", "risk_score": 90, "index": ["logs-endpoint.events.process-*"], "query": "process.command_line:*delete shadows*"}
{"name": "USB Activity Detection", "rule_id": "f4d06194-9846-4833-b8b0-40d352e05cd3", "type": "query", "severity": "low", "risk_score": 25, "index": ["logs-endpoint.events.file-*"], "query": "file.path:*USB*"}
